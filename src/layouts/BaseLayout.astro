---
import "../styles/global.css";
import SEO, { type Props as SEOProps } from "../components/SEO.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../site.config";

type Props = SEOProps;
---

<!doctype html>
<html lang="en">
  <head>
    <SEO {...Astro.props} />
  </head>
  <body class="flex min-h-screen flex-col bg-white font-sans text-slate-800 antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:p-2">
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Sticky call bar on mobile: most enquiries will be urgent phone calls -->
    <a
      href={site.phoneHref}
      class="fixed inset-x-0 bottom-0 z-50 flex items-center justify-center gap-2 bg-accent-500 py-4 font-semibold text-white shadow-[0_-2px_8px_rgba(0,0,0,0.15)] md:hidden"
    >
      Call now: {site.phone}
    </a>
  </body>
</html>
