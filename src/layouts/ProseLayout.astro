---
// Shared layout for Markdown-driven pages (services, areas, blog posts, about).
import BaseLayout from "./BaseLayout.astro";
import CallButton from "../components/CallButton.astro";
import type { Props as SEOProps } from "../components/SEO.astro";

interface Props extends SEOProps {
  heading: string;
  eyebrow?: string;
}
const { heading, eyebrow, ...seo } = Astro.props;
---

<BaseLayout {...seo}>
  <section class="bg-brand-50">
    <div class="mx-auto max-w-3xl px-4 py-12">
      {eyebrow && <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">{eyebrow}</p>}
      <h1 class="mt-1 text-3xl font-bold text-brand-900 sm:text-4xl">{heading}</h1>
      <slot name="meta" />
    </div>
  </section>

  <article class="prose prose-slate prose-a:text-brand-600 mx-auto max-w-3xl px-4 py-12">
    <slot />
  </article>

  <aside class="mx-auto mb-16 max-w-3xl px-4">
    <div class="rounded-xl bg-brand-900 p-8 text-white">
      <p class="text-xl font-semibold">Need help with a claim?</p>
      <p class="mt-2 text-brand-100">
        Call for a free, no-obligation chat. We'll tell you honestly whether we can help.
      </p>
      <CallButton class="mt-6" />
    </div>
  </aside>
</BaseLayout>
