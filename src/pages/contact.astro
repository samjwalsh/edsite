---
import BaseLayout from "../layouts/BaseLayout.astro";
import CallButton from "../components/CallButton.astro";
import { site } from "../site.config";

const { street, locality, region, postalCode } = site.address;
const address = [street, locality, region, postalCode].filter(Boolean).join(", ");
---

<BaseLayout title="Contact" description={`Call ${site.phone} or email ${site.email} to talk to a loss assessor.`}>
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-4xl font-bold text-brand-900">Get in touch</h1>
    <p class="mt-4 text-lg text-slate-600">
      The quickest way to reach us is by phone. If you've just had a fire, flood or break-in, call now and we'll tell
      you what to do next.
    </p>

    <dl class="mt-10 grid gap-6 sm:grid-cols-2">
      <div class="rounded-xl border border-slate-200 p-6">
        <dt class="text-sm font-semibold uppercase tracking-wide text-slate-500">Phone</dt>
        <dd class="mt-2">
          <CallButton />
        </dd>
      </div>
      <div class="rounded-xl border border-slate-200 p-6">
        <dt class="text-sm font-semibold uppercase tracking-wide text-slate-500">Email</dt>
        <dd class="mt-2">
          <a href={`mailto:${site.email}`} class="text-lg font-semibold text-brand-600 hover:underline">
            {site.email}
          </a>
        </dd>
      </div>
      <div class="rounded-xl border border-slate-200 p-6">
        <dt class="text-sm font-semibold uppercase tracking-wide text-slate-500">Hours</dt>
        <dd class="mt-2">{site.hours}</dd>
      </div>
      {address && (
        <div class="rounded-xl border border-slate-200 p-6">
          <dt class="text-sm font-semibold uppercase tracking-wide text-slate-500">Office</dt>
          <dd class="mt-2">{address}</dd>
        </div>
      )}
    </dl>
  </section>
</BaseLayout>
