# Copy to .env next to docker-compose.yml. Generate secrets with: openssl rand -hex 32

# Host ports the reverse proxy connects to
SITE_PORT=8090
UMAMI_PORT=8091

# Where Postgres stores Umami's data. On Unraid use appdata, e.g. /mnt/user/appdata/edsite/umami-db
UMAMI_DB_DIR=./umami-db

UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
UMAMI_2FA_KEY=
