---
import { nav, site } from "../site.config";

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="text-lg font-bold text-brand-900">
      {site.name}
    </a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-6 text-sm font-medium">
        {nav.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={["hover:text-brand-600", isActive(href) ? "text-brand-600" : "text-slate-700"]}
              aria-current={isActive(href) ? "page" : undefined}
            >
              {label}
            </a>
          </li>
        ))}
        <li>
          <a href={site.phoneHref} class="rounded-lg bg-accent-500 px-4 py-2 text-white hover:bg-accent-600">
            {site.phone}
          </a>
        </li>
      </ul>
    </nav>

    <!-- Mobile menu: native <details>, no JS needed -->
    <details class="group relative md:hidden">
      <summary class="cursor-pointer list-none rounded-md p-2 text-brand-900 [&::-webkit-details-marker]:hidden">
        <span class="sr-only">Menu</span>
        <svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </summary>
      <nav
        aria-label="Mobile"
        class="absolute right-0 mt-2 w-56 rounded-lg border border-slate-200 bg-white p-2 shadow-lg"
      >
        <ul>
          {nav.map(({ href, label }) => (
            <li>
              <a href={href} class="block rounded px-3 py-2 text-slate-700 hover:bg-brand-50">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>
