---
import BaseLayout from "../layouts/BaseLayout.astro";
import CallButton from "../components/CallButton.astro";
---

<BaseLayout title="Page not found" noindex>
  <section class="mx-auto max-w-3xl px-4 py-24 text-center">
    <h1 class="text-4xl font-bold text-brand-900">Page not found</h1>
    <p class="mt-4 text-slate-600">
      That page doesn't exist. Try the{" "}
      <a href="/" class="text-brand-600 underline">
        homepage
      </a>
      , or give us a call.
    </p>
    <CallButton class="mt-8" />
  </section>
</BaseLayout>
