---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const fmt = new Intl.DateTimeFormat("en-IE", { dateStyle: "long" });
---

<BaseLayout
  title="Claims advice"
  description="Practical advice on making an insurance claim after fire, flood, storm or burglary."
>
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-4xl font-bold text-brand-900">Claims advice</h1>
    {posts.length === 0 && <p class="mt-6 text-slate-600">New articles coming soon.</p>}
    <ul class="mt-10 divide-y divide-slate-200">
      {posts.map((p) => (
        <li class="py-6">
          <a href={`/blog/${p.id}`} class="group block">
            <time datetime={p.data.pubDate.toISOString()} class="text-sm text-slate-500">
              {fmt.format(p.data.pubDate)}
            </time>
            <h2 class="mt-1 text-xl font-semibold text-brand-900 group-hover:text-brand-600">{p.data.title}</h2>
            <p class="mt-2 text-slate-600">{p.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
